<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MonthlyReport" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40" whenNoDataType="AllSectionsNoDetail">
<queryString><![CDATA[SELECT DATE_FORMAT(t.created_at,'%Y-%m') AS month,
       i.name AS item_name,
       COUNT(DISTINCT c.id) AS customers,
       SUM(t.quantity) AS units,
       COUNT(*) AS records,
       SUM(t.total) AS total
FROM simple_orders t
JOIN simple_customers c ON c.id=t.customer_id
JOIN simple_bouquets i ON i.id=t.item_id
GROUP BY DATE_FORMAT(t.created_at,'%Y-%m'),i.id,i.name
ORDER BY month DESC,total DESC,i.name]]></queryString>
<field name="month" class="java.lang.String"/><field name="item_name" class="java.lang.String"/><field name="customers" class="java.lang.Long"/><field name="units" class="java.math.BigDecimal"/><field name="records" class="java.lang.Long"/><field name="total" class="java.math.BigDecimal"/>
<title><band height="80"><staticText><reportElement x="0" y="0" width="515" height="35"/><textElement><font size="20"/></textElement><text><![CDATA[BloomDesk - Monthly demand]]></text></staticText><staticText><reportElement x="0" y="40" width="515" height="30"/><textElement><font size="10"/></textElement><text><![CDATA[Compare bouquet demand, customer reach and revenue to plan purchases.]]></text></staticText></band></title>
<columnHeader><band height="32"><staticText><reportElement x="0" y="0" width="68" height="28"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Month]]></text></staticText><staticText><reportElement x="70" y="0" width="168" height="28"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Bouquet]]></text></staticText><staticText><reportElement x="240" y="0" width="63" height="28"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Customers]]></text></staticText><staticText><reportElement x="305" y="0" width="48" height="28"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Units]]></text></staticText><staticText><reportElement x="355" y="0" width="48" height="28"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Orders]]></text></staticText><staticText><reportElement x="410" y="0" width="105" height="28"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Revenue (LKR)]]></text></staticText></band></columnHeader>
<detail><band height="30"><textField isStretchWithOverflow="true"><reportElement x="0" y="0" width="68" height="26"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{month}]]></textFieldExpression></textField><textField isStretchWithOverflow="true"><reportElement x="70" y="0" width="168" height="26"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{item_name}]]></textFieldExpression></textField><textField isStretchWithOverflow="true"><reportElement x="240" y="0" width="63" height="26"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{customers}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" pattern="#,##0"><reportElement x="305" y="0" width="48" height="26"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{units}]]></textFieldExpression></textField><textField isStretchWithOverflow="true"><reportElement x="355" y="0" width="48" height="26"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{records}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="410" y="0" width="105" height="26"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField></band></detail>
</jasperReport>
